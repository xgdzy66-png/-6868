# 在 https://my.telegram.org/apps 获取应用凭据，不是 BotFather Token。
TG_API_ID=
TG_API_HASH=

# 先登录，再运行 python -m tg_ai groups 获取群 ID，多个群用英文逗号隔开。
TG_ALLOWED_GROUPS=
# 可选：其他能控制管家的用户 ID；本账号本人始终拥有权限。
TG_OWNER_IDS=

# 自己的 OpenAI 或兼容服务凭据。BASE_URL 应包含 /v1，不要包含 /chat/completions。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
# GPT 使用 max_completion_tokens；许多其他兼容模型使用 max_tokens。
AI_TOKEN_PARAMETER=max_completion_tokens
AI_OUTPUT_TOKENS=1200
# 可选服务参数，如 Manus GPT 代理可配置 {"reasoning":{"effort":"minimal"}}。
AI_EXTRA_JSON={}

# 默认先试运行：AI 生成草稿但不发送到群，用收藏夹 /ai_preview 查看。
CHAT_DRY_RUN=true
# mentions：只响应 @/回复本人；smart：这些必回应，普通聊天概率接话；all：每条参与。
# 以上模式均受冷却、配额、[SKIP] 和暂停状态约束，不保证每条发送。
CHAT_REPLY_MODE=smart
CHAT_REPLY_PROBABILITY=0.15
CHAT_COOLDOWN_SECONDS=60
CHAT_HOURLY_LIMIT=20
CHAT_DAILY_LIMIT=100
CHAT_DELAY_MIN=2
CHAT_DELAY_MAX=5
CHAT_MAX_REPLY_CHARS=500
CHAT_CONTEXT_MESSAGES=24
CHAT_RETENTION_HOURS=24
CHAT_MAX_MESSAGE_AGE=120
CHAT_STATE_DIR=data
CHAT_PERSONA="你是群里的 AI 管家，性格友好，口吻自然，不说长篇大论。适时接话，帮助回答问题，避免尬聊。默认用中文，但对方用其他语言时跟随。"
